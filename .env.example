# Capital.com API (account demo per test, live per produzione)
CAPITAL_API_KEY=
CAPITAL_API_PASSWORD=
CAPITAL_IDENTIFIER=
# Imposta a "demo" per usare l'ambiente demo, "live" per quello reale
CAPITAL_ENV=demo

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=
# Modello principale: usato da analyzer dei setup e monitor di chiusura.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Modello fast: usato dal briefing 3x/giorno (task di sintesi, basso ragionamento).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Finnhub (opzionale): se vuoto, il briefing usa solo i dati Capital.
# Free tier sufficiente: registrazione su https://finnhub.io
FINNHUB_API_KEY=

# Sizing: quanti EUR di margine impegnare al massimo per ogni trade.
# Pensato per micro-capitale (60-300 EUR): tieni 10-20 EUR per trade.
# Il rischio effettivo dipende poi dallo stop loss tecnico del singolo setup.
MARGIN_BUDGET_EUR=15
MAX_OPEN_POSITIONS=1
MIN_SCORE_THRESHOLD=7

# Modalita di esecuzione su Capital.com:
#   coach   -> solo notifica Telegram, esegui a mano (default sicuro)
#   confirm -> manda setup + bottoni Esegui/Salta su Telegram. Se clicchi
#              Esegui, apre la posizione. Se clicchi Salta o non rispondi
#              entro CONFIRM_TIMEOUT_SEC, marca il signal come skipped/expired.
#   auto    -> il bot apre direttamente la posizione (con tutti i safety attivi)
EXECUTION_MODE=coach

# Quanti secondi il bot resta in attesa del tuo click in modalita confirm.
# Default 240 (4 minuti). Massimo consigliato 270 per stare nel timeout
# del workflow GitHub Actions (5 min totali con margine per il resto).
CONFIRM_TIMEOUT_SEC=240

# Soglia R:R minimo (vs livelli SL/TP originali del setup) per aprire al click.
# Se tra discovery e click il prezzo si muove a sfavore e il rapporto
# reward/rischio scende sotto questa soglia, il bot annulla l'apertura.
# 1.2 = permissivo (apre quasi sempre), 1.5 = bilanciato, 2.0 = conservativo.
MIN_RR_AT_ENTRY=1.2
